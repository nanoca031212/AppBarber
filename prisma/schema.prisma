generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id        String    @id @default(cuid())
  nome      String
  telefone  String
  email     String?   @unique
  senha     String?
  createdAt DateTime  @default(now())
  reservas  Reserva[]
}

model Barbeiro {
  id                       String            @id @default(cuid())
  nome                     String
  descricao                String?
  foto                     String?
  fotoPosicao              String?
  ativo                    Boolean           @default(true)
  createdAt                DateTime          @default(now())
  notificarCancelamento    Boolean           @default(true)
  notificarNovoAgendamento Boolean           @default(true)
  whatsapp                 String?
  servicos                 BarbeiroServico[]
  reservas                 Reserva[]
}

model Servico {
  id          String            @id @default(cuid())
  nome        String
  descricao   String?
  preco       Float
  duracao     Int
  foto        String?
  fotoPosicao String?
  ativo       Boolean           @default(true)
  createdAt   DateTime          @default(now())
  barbeiros   BarbeiroServico[]
  reservas    ReservaServico[]
}

model BarbeiroServico {
  barbeiroId String
  servicoId  String
  barbeiro   Barbeiro @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)
  servico    Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@id([barbeiroId, servicoId])
}

model Reserva {
  id         String           @id @default(cuid())
  clienteId  String
  barbeiroId String
  data       DateTime
  horario    String
  status     StatusReserva    @default(PENDENTE)
  total      Float
  createdAt  DateTime         @default(now())
  barbeiro   Barbeiro         @relation(fields: [barbeiroId], references: [id])
  cliente    Cliente          @relation(fields: [clienteId], references: [id])
  servicos   ReservaServico[]
}

model ReservaServico {
  reservaId String
  servicoId String
  reserva   Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  servico   Servico @relation(fields: [servicoId], references: [id])

  @@id([reservaId, servicoId])
}

model HorarioFuncionamento {
  id                String   @id @default(cuid())
  horaInicio        String   @default("08:00")
  horaFim           String   @default("19:00")
  intervalo         Int      @default(30)
  pausaAtiva        Boolean  @default(false)
  pausaInicio       String?
  pausaFim          String?
  diasFuncionamento Int[]    @default([1, 2, 3, 4, 5, 6])
  updatedAt         DateTime @updatedAt
}

model HorarioDiaPersonalizado {
  diaSemana   Int      @id
  horaInicio  String
  horaFim     String
  pausaAtiva  Boolean  @default(false)
  pausaInicio String?
  pausaFim    String?
  updatedAt   DateTime @updatedAt
}

model PerfilNegocio {
  id                     String   @id @default(cuid())
  nomeBarbearia          String
  endereco               String?
  telefone               String?
  barbeiroNome           String
  barbeiroDescricao      String?
  barbeiroFoto           String?
  updatedAt              DateTime @updatedAt
  capaFoto               String?
  capaFotoPosicao        String?
  capaFotoPosicaoDesktop String?
  capaFotoDesktop        String?
}

model WhatsappNotificacaoConfig {
  id                     String   @id
  confirmacaoAgendamento Boolean  @default(true)
  lembreteAgendamento    Boolean  @default(true)
  horasAntesLembrete     Int      @default(2)
  avisoCancelamento      Boolean  @default(true)
  updatedAt              DateTime
}

model WhatsappTemplate {
  id        String   @id
  nome      String
  mensagem  String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

enum StatusReserva {
  PENDENTE
  CONFIRMADO
  CANCELADO
  CONCLUIDO
}
